  "expected_changes": [
    {"id": "mihomo-fake-ip-explicit", "description": "The old baseline left enhanced DNS mode implicit; the candidate explicitly enables fake-ip and separately reports resolver ownership."},
    {"id": "nintendo-real-ip", "description": "Preserve both ATT real-IP entries and add the dedicated srv.nintendo.net STUN subtree plus the legacy n.n.srv.nintendo.net subtree."},
    {"id": "node-endpoint-bypass", "description": "Add direct rules for upstream proxy node IPs and hostnames to prevent proxy and DNS loops."},
    {"id": "mihomo-test-selector", "description": "Mihomo exposes the US and JP TUIC nodes as direct leaves and retains only TEST = select, US, JP, DIRECT."},
    {"id": "surge-country-selectors", "description": "Surge retains one Snell protocol version 6 and one TUIC leaf per country; TEST lists those four direct leaves and DIRECT."},
    {"id": "legacy-auto-fixed-us", "description": "Legacy proxy and cross-country Smart targets are normalized to fixed US based on the observed baseline selection; country selection is explicit in the candidate."},
    {"id": "dns-endpoints", "description": "Keep the dual US and domestic resolver sets, use one JP endpoint and a dedicated TEST endpoint, and limit endpoint routing to protocol-qualified DoH rules."}
  ],
  "unsupported_cases": [
    {"id": "surge-ios-process-rules", "reason": "Surge iOS does not apply PROCESS-NAME rules; the profile comparison covers archived matcher inputs, not iOS process visibility."},
    {"id": "surge-url-regex", "reason": "URL-REGEX matching is not modeled by the domain-only first-match index; matching baseline rules are listed as unsupported instead of being ignored."},
    {"id": "sni-http-host-metadata", "reason": "SNI, HTTP Host, TLS state and socket resolution state are not represented by the static RuleIndex; independent engine checks are required for those subjects."},
    {"id": "dns-resolution-failure", "reason": "The static comparison models resolver ownership, not live DNS failures or Surge dns-failed fallback timing."},
    {"id": "geoip-asn-database", "reason": "GeoIP and ASN behavior uses explicit fixture metadata only; no external network database is consulted."}
  ]
}

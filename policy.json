          "other-async-webps-prod-a-1.webpubsub.azure.com",
          "chatgpt-async-webps-prod-a-1.webpubsub.azure.com.evil.test"
        ],
        "wildcard_additionally_matches": [
          "chatgpt-async-webps-prod--1.webpubsub.azure.com",

  "regex_adapters": [
    {
      "source": "^chatgpt-async-webps-prod-\\S+-\\d+\\.webpubsub\\.azure\\.com$",
      "output_type": "DOMAIN-WILDCARD",
      "output_value": "chatgpt-async-webps-prod-*-*.webpubsub.azure.com",
      "reason": "Keep the previously reviewed ChatGPT Azure endpoint rule; the wildcard intentionally allows an empty or nonnumeric second segment.",
      "review_date": "2026-09-26",
      "samples": {
        "source_matches": [
          "chatgpt-async-webps-prod-a-1.webpubsub.azure.com",
          "chatgpt-async-webps-prod-part.with.dot-42.webpubsub.azure.com"
        ],
        "source_rejects": [
          "chatgpt-async-webps-prod--1.webpubsub.azure.com",
          "other-async-webps-prod-a-1.webpubsub.azure.com",
          "chatgpt-async-webps-prod-a-1.webpubsub.azure.com.evil.test"
        ],
        "wildcard_additionally_matches": [
          "chatgpt-async-webps-prod--1.webpubsub.azure.com",
          "chatgpt-async-webps-prod-a-anything.webpubsub.azure.com"
        ]
      }
    }
  ],
